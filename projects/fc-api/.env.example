# 本地开发监听端口
PORT=8787

# 管理后台鉴权令牌（默认 dev-admin-token）
ADMIN_API_TOKEN=dev-admin-token

# 微信云函数转发验签密钥（本地联调可留空；线上由 Pulumi 自动生成并注入）
PROXY_SHARED_SECRET=

# CORS 允许的前端域名（逗号分隔，支持通配符如 https://*.pages.dev；本地默认 *）
CORS_ALLOW_ORIGINS=*

# 阿里云 TableStore 配置（留空时自动降级为内存种子库，便于本地免账号启动）
OTS_ENDPOINT=
OTS_INSTANCE_NAME=
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
OTS_TABLE_CATEGORIES=categories
OTS_TABLE_PRODUCTS=products
OTS_TABLE_BANNERS=banners
OTS_TABLE_USERS=users
